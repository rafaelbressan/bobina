{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix site --registry=https://registry.npmjs.org/",
  "buildCommand": "npm run build --prefix site",
  "outputDirectory": "site/dist",
  "routes": [
    {
      "src": "^/.*",
      "headers": { "X-Content-Type-Options": "nosniff", "Referrer-Policy": "strict-origin-when-cross-origin" },
      "continue": true
    },
    {
      "src": "^/_astro/.+",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?:[^.]*)$",
      "headers": { "Vary": "Accept" },
      "continue": true
    },
    {
      "src": "^/.+\\.md$",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" },
      "continue": true
    },
    {
      "src": "^/llms(?:-full)?\\.txt$",
      "headers": { "Content-Type": "text/plain; charset=utf-8" },
      "continue": true
    },
    { "src": "^/problems/B(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/b$1$2" } },
    { "src": "^/problems/E(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/e$1$2" } },
    { "src": "^/problems/F(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/f$1$2" } },
    { "src": "^/problems/I(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/i$1$2" } },
    { "src": "^/problems/L(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/l$1$2" } },
    { "src": "^/problems/M(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/m$1$2" } },
    { "src": "^/problems/P(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/p$1$2" } },
    { "src": "^/problems/Q(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/q$1$2" } },
    { "src": "^/problems/S(\\d{3})(/?|\\.md)$", "status": 308, "headers": { "Location": "/problems/s$1$2" } },
    {
      "src": "^/$",
      "has": [{ "type": "header", "key": "accept", "value": { "re": "text/markdown" } }],
      "dest": "/index.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" }
    },
    {
      "src": "^/((?:[^/.]+/)*[^/.]+)/?$",
      "has": [{ "type": "header", "key": "accept", "value": { "re": "text/markdown" } }],
      "dest": "/$1.md",
      "headers": { "Content-Type": "text/markdown; charset=utf-8", "Vary": "Accept" }
    }
  ]
}
