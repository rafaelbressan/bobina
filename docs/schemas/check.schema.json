{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobina.check/1",
  "title": "bobina check FILE --json",
  "type": "object",
  "required": [
    "stats",
    "problems"
  ],
  "properties": {
    "stats": {
      "type": "object",
      "required": [
        "length_mm",
        "native_rows",
        "raster_rows",
        "bytes",
        "profile"
      ],
      "properties": {
        "length_mm": {
          "type": "number"
        },
        "native_rows": {
          "type": "integer"
        },
        "raster_rows": {
          "type": "integer"
        },
        "bytes": {
          "type": "integer"
        },
        "profile": {
          "type": "string"
        },
        "counters": {
          "type": "object"
        },
        "renders": {
          "type": "integer"
        },
        "copies": {
          "type": "integer"
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "problem.schema.json"
      }
    },
    "data_columns": {
      "type": "array",
      "description": "with --data: per part of the job, its data files and the columns {{ }} can use",
      "items": {
        "type": "object",
        "required": [
          "part",
          "document",
          "data",
          "columns"
        ],
        "properties": {
          "part": {
            "type": "integer"
          },
          "document": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "columns": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
