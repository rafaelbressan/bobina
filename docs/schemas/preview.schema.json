{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bobina.preview/1",
  "title": "bobina preview ... --json",
  "type": "object",
  "required": [
    "schema",
    "exit",
    "files",
    "stats",
    "problems"
  ],
  "properties": {
    "schema": {
      "const": "bobina.preview/1"
    },
    "exit": {
      "type": "integer"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stats": {
      "type": "object"
    },
    "problems": {
      "type": "array",
      "items": {
        "$ref": "problem.schema.json"
      }
    }
  }
}
