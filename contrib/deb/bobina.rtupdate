#!/bin/sh
# /usr/share/python3/runtime.d/bobina.rtupdate of the .deb (tools/build_deb.py): bobina's .pyc files, for one
# Python. Debian's python3 runs it each time python3 is configured, a new version included
# ("rtupdate python3.11 python3.13"); bobina's postinst runs it as "rtupdate - python3", its prerm as "clean".
# It never fails (a failing hook would fail python3's upgrade): without .pyc files bobina only starts slower.
lib=/usr/lib/bobina

clean() {
    find "$lib" -name '*.pyc' -delete 2>/dev/null
    find "$lib" -depth -type d -name __pycache__ -empty -delete 2>/dev/null
}

case "$1" in
    clean)
        clean
        ;;
    rtupdate)
        case "$3" in
            python3 | python3.[0-9] | python3.[0-9][0-9]) py=/usr/bin/$3 ;;
            *) py=/usr/bin/python3 ;;
        esac
        [ -x "$py" ] || py=/usr/bin/python3
        tag=$("$py" -c 'import sys; print("cp%d%d" % sys.version_info[:2])' 2>/dev/null) || exit 0
        clean
        if [ -d "$lib/$tag" ]; then
            "$py" -m compileall -q -j0 "$lib/common" "$lib/$tag" >/dev/null 2>&1
        fi
        ;;
esac
exit 0
