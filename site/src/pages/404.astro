---
import Base from '../layouts/Base.astro';
---

<Base title="Not found" slug="404">
  <main id="main" class="page">
    <div class="sheet prose">
      <h1>E404: no such page</h1>
      <p>Nothing printed. Try the <a href="/">home page</a>, <a href="/search/">search</a>, or the whole docs in one file: <a
          href="/llms-full.txt">llms-full.txt</a>.</p>
      <p>A problem code from bobina? Its page is <code>/problems/CODE/</code> in lower case, for example <a
          href="/problems/e107/">/problems/e107/</a>.</p>
    </div>
  </main>
</Base>
